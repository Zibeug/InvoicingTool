<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="InvoicingTool.App.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InvoicingTool.App.Views"
    xmlns:vm="clr-namespace:InvoicingTool.Presentation.ViewModels;assembly=InvoicingTool.Presentation"
    xmlns:model="clr-namespace:InvoicingTool.Core.Models;assembly=InvoicingTool.Core"
    x:DataType="vm:CatalogViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Prestation" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Items}" Margin="12,8">
        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="24" Spacing="12" HorizontalOptions="Center">
                <Label Text="Enregistrez vos prestations habituelles (ex. « Peinture murs 2 couches » au m²) pour remplir vos devis en quelques secondes."
                       HorizontalTextAlignment="Center" />
                <Button Text="Ajouter une prestation" Command="{Binding AddCommand}" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="model:CatalogItem">
                <Border Style="{StaticResource Card}" Margin="0,4">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, x:DataType=vm:CatalogViewModel}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="{Binding Label}" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding Description}" Style="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding UnitPrice, Converter={StaticResource Money}}" FontFamily="OpenSansSemibold" />
                                    <Span Text=" / " />
                                    <Span Text="{Binding Unit}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</views:BasePage>
