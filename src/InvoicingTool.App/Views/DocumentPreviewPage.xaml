<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="InvoicingTool.App.Views.DocumentPreviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InvoicingTool.App.Views"
    xmlns:vm="clr-namespace:InvoicingTool.Presentation.ViewModels;assembly=InvoicingTool.Presentation"
    x:DataType="vm:DocumentPreviewViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Envoyer PDF" Command="{Binding SharePdfCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <WebView x:Name="Browser" />
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Padding="12">
            <Button Text="Ouvrir le PDF" Command="{Binding OpenPdfCommand}" Style="{StaticResource OutlineButton}" />
            <Button Grid.Column="1" Text="Envoyer le PDF" Command="{Binding SharePdfCommand}" />
        </Grid>
        <ActivityIndicator Grid.RowSpan="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</views:BasePage>
