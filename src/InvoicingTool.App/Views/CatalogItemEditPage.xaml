<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="InvoicingTool.App.Views.CatalogItemEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InvoicingTool.App.Views"
    xmlns:vm="clr-namespace:InvoicingTool.Presentation.ViewModels;assembly=InvoicingTool.Presentation"
    x:DataType="vm:CatalogItemEditViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Enregistrer" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="6">
            <Label Text="Libellé *" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Label}" Placeholder="Ex. Peinture murs, 2 couches" />
            <Label Text="Description (détail imprimé sur le devis)" Style="{StaticResource FieldLabel}" />
            <Editor Text="{Binding Description}" AutoSize="TextChanges" />
            <Label Text="Unité" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding CommonUnits}" SelectedItem="{Binding Unit}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout>
                    <Label Text="Prix unitaire HT (€)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding UnitPriceText}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="TVA (%)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding VatRateText}" Keyboard="Numeric" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Rappel : 10 % pour les travaux de rénovation d'un logement de plus de 2 ans, 5,5 % pour la rénovation énergétique, 20 % sinon."
                   Style="{StaticResource Secondary}" Margin="0,4" />
            <Button Text="Enregistrer" Command="{Binding SaveCommand}" Margin="0,12,0,0" />
            <Button Text="Supprimer" Command="{Binding DeleteCommand}" IsVisible="{Binding IsExisting}" Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
