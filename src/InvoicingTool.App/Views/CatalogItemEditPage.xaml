<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="InvoicingTool.App.Views.CatalogItemEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InvoicingTool.App.Views"
    xmlns:vm="clr-namespace:InvoicingTool.Presentation.ViewModels;assembly=InvoicingTool.Presentation"
    x:DataType="vm:CatalogItemEditViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Enregistrer" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Aperçu en direct -->
            <Label Text="Aperçu" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Card}" Padding="12,10">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.08" Radius="6" Offset="0,2" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                            BackgroundColor="{Binding AccentColor, Converter={StaticResource HexToColor}}">
                        <Label Text="{Binding PreviewInitials}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="{Binding PreviewTitle}" FontFamily="OpenSansSemibold" FontSize="16"
                           VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                        <Label Text="{Binding PreviewPrice}" FontFamily="OpenSansSemibold" FontSize="17" HorizontalTextAlignment="End" />
                        <Label Text="{Binding PreviewUnit}" Style="{StaticResource Secondary}" FontSize="12" HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Description -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Article" FontFamily="OpenSansSemibold" FontSize="16" />
                    <Label Text="Libellé *" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Label}" Placeholder="Ex. Heure de conseil" />
                    <Label Text="Description (facultative, imprimée sous le libellé)" Style="{StaticResource FieldLabel}" />
                    <Editor Text="{Binding Description}" AutoSize="TextChanges" Placeholder="Détails, conditions…" />
                </VerticalStackLayout>
            </Border>

            <!-- Prix -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Prix" FontFamily="OpenSansSemibold" FontSize="16" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="{Binding PriceLabel}" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding UnitPriceText}" Keyboard="Numeric" FontSize="18" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Unité" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding CommonUnits}" SelectedItem="{Binding Unit}" />
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout IsVisible="{Binding ShowVat}" Spacing="6">
                        <Label Text="TVA (%)" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding VatRateText}" Keyboard="Numeric" />
                        <Label Text="{Binding TaxRateHint}" Style="{StaticResource Secondary}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Enregistrer" Command="{Binding SaveCommand}" />
            <Button Text="Supprimer l'article" Command="{Binding DeleteCommand}" IsVisible="{Binding IsExisting}"
                    Style="{StaticResource DangerButton}" Margin="0,0,0,16" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
