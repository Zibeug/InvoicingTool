<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="InvoicingTool.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InvoicingTool.App.Views"
    xmlns:vm="clr-namespace:InvoicingTool.Presentation.ViewModels;assembly=InvoicingTool.Presentation"
    xmlns:model="clr-namespace:InvoicingTool.Core.Models;assembly=InvoicingTool.Core"
    x:DataType="vm:SettingsViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Enregistrer" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="6">
            <Label Text="Ces informations apparaissent sur vos devis et factures." Style="{StaticResource Secondary}" />

            <Label Text="Pays et devise" Style="{StaticResource SectionTitle}" />
            <Label Text="Pays (règles de TVA et mentions légales)" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding Countries}" ItemDisplayBinding="{Binding Name, x:DataType=model:CountryProfile}"
                    SelectedItem="{Binding SelectedCountry}" />
            <Label Text="Devise des nouveaux documents" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding CurrencyList}" ItemDisplayBinding="{Binding DisplayName, x:DataType=model:Currency}"
                    SelectedItem="{Binding SelectedCurrency}" />

            <Label Text="Entreprise" Style="{StaticResource SectionTitle}" />
            <Label Text="Nom de l'entreprise" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding CompanyName}" />
            <Label Text="Nom du dirigeant" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding OwnerName}" />
            <Label Text="Adresse" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Address}" />
            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="8">
                <VerticalStackLayout>
                    <Label Text="Code postal" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding PostalCode}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Ville" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding City}" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Téléphone" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Phone}" Keyboard="Telephone" />
            <Label Text="E-mail" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Email}" Keyboard="Email" />
            <Label Text="{Binding CompanyIdLabel}" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Siret}" Placeholder="{Binding CompanyIdExample}" />
            <Label Text="{Binding InsuranceLabel, StringFormat='{0} (assureur, n° de contrat, zone couverte)'}" Style="{StaticResource FieldLabel}" />
            <Editor Text="{Binding InsuranceInfo}" AutoSize="TextChanges" />
            <Label Text="IBAN" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Iban}" />

            <Label Text="TVA" Style="{StaticResource SectionTitle}" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Non assujetti à la TVA (franchise, petite entreprise)" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding VatExempt}" />
            </Grid>
            <VerticalStackLayout IsVisible="{Binding VatExempt}" Spacing="6">
                <Label Text="Mention imprimée sur les documents" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding VatExemptionMention}" />
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding VatExempt, Converter={StaticResource Not}}" Spacing="6">
                <Label Text="{Binding VatNumberLabel}" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding VatNumber}" Placeholder="{Binding VatNumberExample}" />
                <Label Text="Taux de TVA proposés (%) — séparés par « ; »" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding TaxRatesText}" />
                <Label Text="{Binding TaxRateHint}" Style="{StaticResource Secondary}" />
                <Label Text="Taux par défaut des nouvelles lignes (%)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding DefaultVatRateText}" Keyboard="Numeric" />
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Arrondir le total à 0,05 (usage suisse)" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding RoundToFiveCents}" />
            </Grid>

            <Label Text="Devis et factures" Style="{StaticResource SectionTitle}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout>
                    <Label Text="Validité devis (jours)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding QuoteValidityDaysText}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Délai de paiement (jours)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding PaymentTermDaysText}" Keyboard="Numeric" />
                </VerticalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout>
                    <Label Text="Préfixe des devis" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding QuotePrefix}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Préfixe des factures" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding InvoicePrefix}" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Conditions de paiement (mentions légales en bas de facture)" Style="{StaticResource FieldLabel}" />
            <Editor Text="{Binding PaymentTerms}" AutoSize="TextChanges" />

            <Button Text="Enregistrer" Command="{Binding SaveCommand}" Margin="0,12,0,24" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
