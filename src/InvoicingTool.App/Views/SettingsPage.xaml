<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="InvoicingTool.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InvoicingTool.App.Views"
    xmlns:vm="clr-namespace:InvoicingTool.Presentation.ViewModels;assembly=InvoicingTool.Presentation"
    xmlns:model="clr-namespace:InvoicingTool.Core.Models;assembly=InvoicingTool.Core"
    x:DataType="vm:SettingsViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Enregistrer" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="6">

            <!-- Sauvegarde en premier : les données ne sont que sur ce téléphone -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Sauvegarde des données" FontFamily="OpenSansSemibold" FontSize="16" />
                    <Label Text="Vos données sont enregistrées uniquement sur ce téléphone. Exportez régulièrement une sauvegarde et gardez-la ailleurs (e-mail, Drive, iCloud, ordinateur)."
                           Style="{StaticResource Secondary}" />
                    <Label Text="{Binding LastBackupDisplay, StringFormat='Dernière sauvegarde : {0}'}" FontSize="13" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Exporter" Command="{Binding ExportBackupCommand}" />
                        <Button Grid.Column="1" Text="Restaurer" Command="{Binding RestoreBackupCommand}" Style="{StaticResource OutlineButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Entreprise" Style="{StaticResource SectionTitle}" />
            <Label Text="Ces informations apparaissent sur vos devis et factures." Style="{StaticResource Secondary}" />
            <Label Text="Nom de l'entreprise" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding CompanyName}" />
            <Label Text="Nom du dirigeant (facultatif)" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding OwnerName}" />
            <Label Text="Adresse" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Address}" />
            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="8">
                <VerticalStackLayout>
                    <Label Text="Code postal" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding PostalCode}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Ville" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding City}" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Téléphone" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Phone}" Keyboard="Telephone" />
            <Label Text="E-mail" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Email}" Keyboard="Email" />
            <Label Text="{Binding CompanyIdLabel}" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding CompanyId}" Placeholder="{Binding CompanyIdExample}" />
            <Label Text="IBAN (imprimé sur les factures pour le paiement par virement)" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Iban}" Placeholder="CH93 0076 2011 6238 5295 7" Keyboard="Text" />

            <!-- QR-facture suisse : visible pour une entreprise en Suisse -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsSwitzerland}" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="QR-facture" FontFamily="OpenSansSemibold" FontSize="16" />
                            <Label Text="Section paiement avec code QR en bas des factures en CHF" Style="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding QrBillEnabled}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding QrBillStatus}" FontSize="13" TextColor="#E08A00">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsQrBillReady}" Value="True">
                                <Setter Property="TextColor" Value="#2E7D32" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="La référence de paiement (RF…) est tirée du numéro de facture : votre banque rapproche ainsi chaque paiement de sa facture."
                           Style="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Apparence des documents" Style="{StaticResource SectionTitle}" />
            <Label Text="Logo (facultatif)" Style="{StaticResource FieldLabel}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Style="{StaticResource Card}" Padding="4" WidthRequest="90" HeightRequest="90" IsVisible="{Binding HasLogo}">
                    <Image Source="{Binding Logo, Converter={StaticResource BytesToImage}}" Aspect="AspectFit" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <Button Text="Choisir un logo" Command="{Binding PickLogoCommand}" Style="{StaticResource OutlineButton}" />
                    <Button Text="Retirer le logo" Command="{Binding RemoveLogoCommand}" IsVisible="{Binding HasLogo}"
                            Style="{StaticResource DangerButton}" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Couleur des titres et du tableau" Style="{StaticResource FieldLabel}" />
            <CollectionView ItemsSource="{Binding AccentColors}" ItemsLayout="HorizontalList" HeightRequest="52">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border WidthRequest="40" HeightRequest="40" Margin="0,0,8,0" StrokeShape="RoundRectangle 20" StrokeThickness="0"
                                BackgroundColor="{Binding ., Converter={StaticResource HexToColor}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectColorCommand, Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, x:DataType=vm:SettingsViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <BoxView WidthRequest="28" HeightRequest="28" CornerRadius="14" VerticalOptions="Center"
                         Color="{Binding AccentColor, Converter={StaticResource HexToColor}}" />
                <Entry Grid.Column="1" Text="{Binding AccentColor}" Placeholder="#2B5797" />
            </Grid>

            <Label Text="Pays et devise" Style="{StaticResource SectionTitle}" />
            <Label Text="Pays" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding Countries}" ItemDisplayBinding="{Binding Name, x:DataType=model:CountryProfile}"
                    SelectedItem="{Binding SelectedCountry}" />
            <Label Text="Devise" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding CurrencyList}" ItemDisplayBinding="{Binding DisplayName, x:DataType=model:Currency}"
                    SelectedItem="{Binding SelectedCurrency}" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Arrondir les totaux à 0,05" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding RoundToFiveCents}" />
            </Grid>

            <Label Text="TVA" Style="{StaticResource SectionTitle}" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Mon entreprise n'est pas assujettie à la TVA" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding VatExempt}" />
            </Grid>
            <!-- Non assujetti : la TVA disparaît de toute l'application, seule une mention légale reste possible -->
            <VerticalStackLayout IsVisible="{Binding VatExempt}" Spacing="6">
                <Label Text="La TVA est masquée partout : les prix et les totaux sont des montants nets." Style="{StaticResource Secondary}" />
                <Label Text="Mention imprimée sur les documents (laisser vide si aucune)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding VatExemptionMention}" />
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding IsVatRegistered}" Spacing="6">
                <Label Text="{Binding VatNumberLabel}" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding VatNumber}" Placeholder="{Binding VatNumberExample}" />
                <Label Text="Taux de TVA proposés (%) — séparés par « ; »" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding TaxRatesText}" />
                <Label Text="{Binding TaxRateHint}" Style="{StaticResource Secondary}" />
                <Label Text="Taux par défaut des nouvelles lignes (%)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding DefaultVatRateText}" Keyboard="Numeric" />
            </VerticalStackLayout>

            <Label Text="Devis et factures" Style="{StaticResource SectionTitle}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout>
                    <Label Text="Validité des devis (jours)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding QuoteValidityDaysText}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Délai de paiement (jours)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding PaymentTermDaysText}" Keyboard="Numeric" />
                </VerticalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout>
                    <Label Text="Préfixe des devis" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding QuotePrefix}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Préfixe des factures" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding InvoicePrefix}" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Numérotation de l'année en cours (ex. pour continuer celle d'un ancien logiciel)" Style="{StaticResource FieldLabel}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout>
                    <Label Text="Prochain n° de devis" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding NextQuoteNumberText}" Keyboard="Numeric" />
                    <Label Text="{Binding NextQuotePreview}" Style="{StaticResource Secondary}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Prochain n° de facture" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding NextInvoiceNumberText}" Keyboard="Numeric" />
                    <Label Text="{Binding NextInvoicePreview}" Style="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Conditions de paiement (bas des factures)" Style="{StaticResource FieldLabel}" />
            <Editor Text="{Binding PaymentTerms}" AutoSize="TextChanges" />

            <Button Text="Enregistrer" Command="{Binding SaveCommand}" Margin="0,12,0,0" />

            <Label Text="Conditions d'utilisation" Style="{StaticResource SectionTitle}" />
            <Label Text="{Binding TermsAcceptedDisplay}" Style="{StaticResource Secondary}" />
            <Button Text="Lire les conditions d'utilisation" Command="{Binding ShowTermsCommand}"
                    Style="{StaticResource OutlineButton}" Margin="0,0,0,24" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
