<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="InvoicingTool.App.Views.DocumentEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InvoicingTool.App.Views"
    xmlns:vm="clr-namespace:InvoicingTool.Presentation.ViewModels;assembly=InvoicingTool.Presentation"
    x:DataType="vm:DocumentEditViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Aperçu / PDF" Command="{Binding PreviewCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="6">

            <!-- En-tête -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Label Text="{Binding ClientName}" FontFamily="OpenSansSemibold" FontSize="18" />
                    <Label Grid.Column="1" Text="{Binding StatusLabel}" FontFamily="OpenSansSemibold" />
                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Number, StringFormat='N° {0}'}" Style="{StaticResource Secondary}" />
                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SignatureLabel}" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" FontSize="13"
                           IsVisible="{Binding HasSignature}" />
                </Grid>
            </Border>

            <!-- Informations générales -->
            <VerticalStackLayout IsEnabled="{Binding IsEditable}" Spacing="6">
                <Label Text="Objet (facultatif)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Subject}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <VerticalStackLayout>
                        <Label Text="Date" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding IssueDate}" Format="dd/MM/yyyy" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="{Binding DueDateLabel}" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding DueDate}" Format="dd/MM/yyyy" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <!-- Lignes -->
            <Label Text="Lignes" Style="{StaticResource SectionTitle}" />
            <Label Text="{Binding TaxRateHint}" IsVisible="{Binding ShowVat}" Style="{StaticResource Secondary}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="8">
                <BindableLayout.EmptyView>
                    <Label Text="Aucune ligne. Ajoutez-en une ci-dessous." Style="{StaticResource Secondary}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:LineItemViewModel">
                        <Border Style="{StaticResource Card}">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" ColumnSpacing="6" RowSpacing="2"
                                  IsEnabled="{Binding IsEditable, Source={RelativeSource AncestorType={x:Type vm:DocumentEditViewModel}}, x:DataType=vm:DocumentEditViewModel}">
                                <Editor Grid.ColumnSpan="3" Text="{Binding Description}" Placeholder="Désignation" AutoSize="TextChanges" />

                                <VerticalStackLayout Grid.Row="1">
                                    <Label Text="Quantité" Style="{StaticResource FieldLabel}" />
                                    <Entry Text="{Binding QuantityText}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                    <Label Text="Unité" Style="{StaticResource FieldLabel}" />
                                    <Entry Text="{Binding Unit}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="2">
                                    <Label Text="{Binding UnitPriceLabel, Source={RelativeSource AncestorType={x:Type vm:DocumentEditViewModel}}, x:DataType=vm:DocumentEditViewModel}"
                                           Style="{StaticResource FieldLabel}" />
                                    <Entry Text="{Binding UnitPriceText}" Keyboard="Numeric" />
                                </VerticalStackLayout>

                                <!-- Taux de TVA : masqué si l'entreprise n'est pas assujettie -->
                                <VerticalStackLayout Grid.Row="2"
                                                     IsVisible="{Binding ShowVat, Source={RelativeSource AncestorType={x:Type vm:DocumentEditViewModel}}, x:DataType=vm:DocumentEditViewModel}">
                                    <Label Text="{Binding TaxName, Source={RelativeSource AncestorType={x:Type vm:DocumentEditViewModel}}, x:DataType=vm:DocumentEditViewModel, StringFormat='{0} (%)'}"
                                           Style="{StaticResource FieldLabel}" />
                                    <Entry Text="{Binding VatRateText}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <Button Grid.Row="2" Grid.Column="1" Text="Supprimer" Style="{StaticResource DangerButton}"
                                        Padding="8,0" HeightRequest="36" VerticalOptions="End"
                                        IsVisible="{Binding IsEditable, Source={RelativeSource AncestorType={x:Type vm:DocumentEditViewModel}}, x:DataType=vm:DocumentEditViewModel}"
                                        Command="{Binding RemoveLineCommand, Source={RelativeSource AncestorType={x:Type vm:DocumentEditViewModel}}, x:DataType=vm:DocumentEditViewModel}"
                                        CommandParameter="{Binding .}" />
                                <VerticalStackLayout Grid.Row="2" Grid.Column="2" VerticalOptions="End">
                                    <Label Text="{Binding LineTotalLabel, Source={RelativeSource AncestorType={x:Type vm:DocumentEditViewModel}}, x:DataType=vm:DocumentEditViewModel}"
                                           Style="{StaticResource FieldLabel}" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding TotalDisplay}" FontFamily="OpenSansSemibold" HorizontalTextAlignment="End" Margin="0,0,0,10" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsEditable}">
                <Button Text="+ Ligne" Command="{Binding AddLineCommand}" Style="{StaticResource OutlineButton}" />
                <Button Grid.Column="1" Text="+ Article" Command="{Binding AddFromCatalogCommand}" Style="{StaticResource OutlineButton}" />
            </Grid>
            <Button Text="Dicter des lignes" Command="{Binding DictateCommand}" IsVisible="{Binding IsEditable}" />

            <!-- Totaux : sans TVA, seul le total s'affiche -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                    <Label Text="Total HT" IsVisible="{Binding ShowVat}" />
                    <Label Grid.Column="1" Text="{Binding TotalExclTaxDisplay}" IsVisible="{Binding ShowVat}" />
                    <Label Grid.Row="1" Text="{Binding TaxName}" IsVisible="{Binding ShowVat}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalVatDisplay}" IsVisible="{Binding ShowVat}" />
                    <Label Grid.Row="2" Text="Arrondi" IsVisible="{Binding HasRounding}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding RoundingDisplay}" IsVisible="{Binding HasRounding}" />
                    <Label Grid.Row="3" Text="{Binding GrandTotalLabel}" FontFamily="OpenSansSemibold" FontSize="16" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding TotalInclTaxDisplay}" FontFamily="OpenSansSemibold" FontSize="16" />
                </Grid>
            </Border>

            <Label Text="Notes / conditions particulières" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Editor Text="{Binding Notes}" AutoSize="TextChanges" IsEnabled="{Binding IsEditable}" />

            <!-- Actions brouillon -->
            <VerticalStackLayout IsVisible="{Binding IsEditable}" Spacing="8" Margin="0,12,0,0">
                <Button Text="Enregistrer le brouillon" Command="{Binding SaveCommand}" Style="{StaticResource OutlineButton}" />
                <Button Text="Émettre (numéroter)" Command="{Binding IssueCommand}" />
                <Button Text="Supprimer le brouillon" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" />
            </VerticalStackLayout>

            <!-- Paiement et rappels (facture émise) -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" IsVisible="{Binding PaymentInfo, Converter={StaticResource IsNotEmpty}}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Paiement" FontFamily="OpenSansSemibold" FontSize="16" />
                    <Label Text="{Binding PaymentInfo}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reminders}" Spacing="4" IsVisible="{Binding HasReminders}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReminderRow">
                                <Label Text="{Binding Text}" FontSize="13" TextDecorations="Underline"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenReminderCommand, Source={RelativeSource AncestorType={x:Type vm:DocumentEditViewModel}}, x:DataType=vm:DocumentEditViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <!-- Enregistrer le paiement, à la date où il a été reçu -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding CanMarkPaid}">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Payée le" Style="{StaticResource FieldLabel}" />
                            <DatePicker Date="{Binding PaymentDate}" Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Marquer comme payée" Command="{Binding MarkPaidCommand}"
                                BackgroundColor="#2E7D32" TextColor="White" VerticalOptions="End" />
                    </Grid>
                    <Button Text="{Binding RemindButtonText}" Command="{Binding RemindCommand}" IsVisible="{Binding CanRemind}"
                            BackgroundColor="#C62828" TextColor="White" />
                    <Button Text="Annuler le paiement" Command="{Binding UndoPaymentCommand}" IsVisible="{Binding CanUndoPayment}"
                            Style="{StaticResource DangerButton}" />
                </VerticalStackLayout>
            </Border>

            <!-- Actions document émis -->
            <VerticalStackLayout IsVisible="{Binding IsEditable, Converter={StaticResource Not}}" Spacing="8" Margin="0,12,0,0">
                <Button Text="Faire signer le client" Command="{Binding SignCommand}" IsVisible="{Binding CanSign}" />
                <Button Text="Aperçu et PDF" Command="{Binding PreviewCommand}" />
                <Button Text="Changer le statut" Command="{Binding ChangeStatusCommand}" IsVisible="{Binding CanChangeStatus}"
                        Style="{StaticResource OutlineButton}" />
                <Button Text="Facturer ce devis" Command="{Binding ConvertToInvoiceCommand}" IsVisible="{Binding CanConvertToInvoice}" />
                <Button Text="Dupliquer" Command="{Binding DuplicateCommand}" Style="{StaticResource OutlineButton}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
