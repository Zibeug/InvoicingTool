<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="InvoicingTool.App.Views.DictationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InvoicingTool.App.Views"
    xmlns:vm="clr-namespace:InvoicingTool.Presentation.ViewModels;assembly=InvoicingTool.Presentation"
    x:DataType="vm:DictationViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="10">
        <Label Text="{Binding Example}" Style="{StaticResource Secondary}" />

        <!-- Gros bouton micro -->
        <Button Grid.Row="1" Text="{Binding ListenButtonText}" Command="{Binding ToggleListenCommand}"
                HeightRequest="64" FontSize="20" CornerRadius="32" />

        <!-- Texte reconnu, modifiable (le micro du clavier fonctionne aussi ici) -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
            <Editor Text="{Binding Text}" Placeholder="Parlez ou tapez vos lignes ici…" AutoSize="TextChanges"
                    MinimumHeightRequest="90" />
            <Button Grid.Row="1" Text="Effacer" Command="{Binding ClearCommand}" Style="{StaticResource DangerButton}"
                    HorizontalOptions="End" Padding="8,0" HeightRequest="36" />
        </Grid>

        <!-- Lignes comprises, mises à jour en direct -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Lines}">
            <CollectionView.Header>
                <Label Text="Lignes comprises" Style="{StaticResource SectionTitle}" />
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="Les lignes apparaîtront ici pendant que vous parlez." Style="{StaticResource Secondary}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DictatedLineRow">
                    <Border Style="{StaticResource Card}" Margin="0,3">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding Detail}" FontSize="13">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding MissingPrice}" Value="True">
                                        <Setter Property="TextColor" Value="#E08A00" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="4" Text="{Binding AddButtonText}" Command="{Binding AddCommand}" />
    </Grid>
</views:BasePage>
