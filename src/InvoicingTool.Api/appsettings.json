{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "invoicingtool-api",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 60
  },
  "RateLimit": {
    "AuthPerMinute": 20
  }
}
