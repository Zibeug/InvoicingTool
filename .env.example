# Copier ce fichier en « .env » et remplacer les valeurs (ne jamais committer le .env).

# Mot de passe de la base PostgreSQL
POSTGRES_PASSWORD=changez-moi-mot-de-passe-base

# Clé de signature des jetons de connexion : au moins 32 caractères aléatoires.
# Exemple pour en générer une :  openssl rand -base64 48
JWT_SECRET=changez-moi-cle-tres-longue-et-aleatoire-0123456789

# Port de l'API sur la machine (http)
API_PORT=8080

# Tentatives de connexion autorisées par minute et par adresse IP
AUTH_REQUESTS_PER_MINUTE=20

# Nom de domaine pour le HTTPS automatique (profil « https »), ex. sync.mon-entreprise.ch
DOMAIN=

# Port du site de présentation (profil « website »)
WEBSITE_PORT=8081
