<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests de l'API contre une vraie base PostgreSQL (variable INVOICING_TEST_POSTGRES),
       et tests de bout en bout : deux « appareils » qui se synchronisent à travers l'API. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InvoicingTool.Api\InvoicingTool.Api.csproj" />
    <ProjectReference Include="..\InvoicingTool.Tests\InvoicingTool.Tests.csproj" />
  </ItemGroup>

</Project>
